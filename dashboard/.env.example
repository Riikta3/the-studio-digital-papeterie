# ──────────────────────────────────────────────────────────────────────────
#  DASHBOARD — modèle de configuration  (npm run dev:dashboard → :3003)
#
#  Copier en `.env.local` et remplir. Les mêmes variables doivent exister sur
#  Vercel (Settings → Environment Variables), sur les 3 environnements.
#
#  Toute variable SANS préfixe NEXT_PUBLIC_ est serveur uniquement et n'arrive
#  jamais dans le bundle navigateur.
# ──────────────────────────────────────────────────────────────────────────


# ─── 1. URLs des applications ─────────────────────────────────────────────
# Origine du dashboard lui-même. Base des liens d'authentification.
NEXT_PUBLIC_DASHBOARD_URL=https://app-the-studio-digital-papeterie.vercel.app

# Origine du landing. Sert à construire les URLs publiques d'invitation :
# QR codes du Jour J, aperçus de l'invitation, popup de bienvenue.
# Une mauvaise valeur produit des QR codes déjà imprimés qui pointent nulle
# part — voir jour-j/qr-code/page.tsx.
NEXT_PUBLIC_LANDING_URL=https://www.thestudiopapeteriedigitale.com

# Landing qui dessine l'aperçu en direct de l'éditeur (/invitation). Facultatif.
# Non définie : http://localhost:3010 en dev (la landing locale, même code que
# l'éditeur, même quand ce dashboard lit la base de prod), sinon
# NEXT_PUBLIC_LANDING_URL. Pour un déploiement de preview Vercel : l'URL de la
# landing de ce déploiement, et côté landing, l'URL de ce dashboard dans
# EDITOR_ALLOWED_ORIGINS.
# EDITOR_PREVIEW_URL=

# Base des liens d'invitation envoyés aux foyers d'invités
# (actions/email-actions.ts). Non définie, les liens partent littéralement en
# « undefined/auth/verify?token=… » et aucun invité ne peut se connecter.
NEXT_PUBLIC_APP_URL=https://app-the-studio-digital-papeterie.vercel.app


# ─── 2. Supabase ──────────────────────────────────────────────────────────
# ANON_KEY : navigateur, soumise aux politiques RLS.
# SERVICE_ROLE_KEY : serveur uniquement, CONTOURNE RLS. Ne jamais exposer.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ─── 3. Stripe ────────────────────────────────────────────────────────────
# Les modules ajoutés après l'achat sont payés dans l'éditeur (Payment
# Element). Le webhook reste celui du landing (/api/webhooks/stripe) : il
# rattrape un onglet fermé, facture et rembourse un double paiement.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx


# ─── 4. Emails transactionnels (Resend) ───────────────────────────────────
# Porte TOUS les emails d'authentification (réinitialisation de mot de passe,
# lien magique, confirmation et changement d'adresse) ainsi que les
# invitations envoyées aux invités.
#
# Supabase n'envoie plus ces messages lui-même : son SMTP partagé est limité à
# quelques envois par heure et ses modèles ne sont pas traduisibles, alors que
# le produit parle neuf langues. Supabase continue de générer et vérifier les
# jetons — voir src/lib/auth-email.ts.
RESEND_API_KEY=


# ─── 5. Intégrations tierces ──────────────────────────────────────────────
# Spotify : recherche de morceaux du module playlist.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
