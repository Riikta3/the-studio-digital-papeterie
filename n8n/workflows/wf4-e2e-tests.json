            "index": 0
          }
        ]
      ]
    },
    "Execute Command": {
      "main": [
        [
          {
            "node": "Read Results File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Results File": {
      "main": [
        [
          {
            "node": "Parse Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Results": {
      "main": [
        [
          {
            "node": "Tests Failed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tests Failed?": {
      "main": [
