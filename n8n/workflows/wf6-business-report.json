{
  "name": "WF6 — Business Report Hebdomadaire",
  "nodes": [
    {
      "id": "wf6-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 500],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 7 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "wf6-compute-week",
      "name": "Compute Week Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 500],
      "parameters": {
        "jsCode": "const now = new Date();\nconst dayOfWeek = now.getUTCDay();\nconst daysToLastMonday = dayOfWeek === 1 ? 7 : (dayOfWeek === 0 ? 6 : dayOfWeek - 1);\nconst lastMonday = new Date(now);\nlastMonday.setUTCDate(now.getUTCDate() - daysToLastMonday);\nlastMonday.setUTCHours(0, 0, 0, 0);\nconst startOfWeekISO = lastMonday.toISOString();\nconst startOfWeekUnix = Math.floor(lastMonday.getTime() / 1000);\nconst weekLabel = lastMonday.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });\nreturn [{ json: { startOfWeekISO, startOfWeekUnix, weekLabel } }];"
      }
    },
    {
      "id": "wf6-weddings",
      "name": "Weddings this week",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 200],
      "parameters": {
        "method": "GET",
        "url": "=https://pftvcpxwbprmphhgwvxc.supabase.co/rest/v1/weddings?created_at=gte.{{ $('Compute Week Range').item.json.startOfWeekISO }}&select=id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "count=exact"
            },
            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_SERVICE_ROLE_KEY_PLACEHOLDER"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "includeResponseHeaders": true,
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      },
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "supabase-rest"
        }
      }
    },
