    {
      "id": "wf6-compute-totals",
      "name": "Compute Totals + Format HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 500],
      "parameters": {
        "jsCode": "const items = $input.all();\nfunction extractCount(item) {\n  const cr = item.json.headers?.['content-range'] || '*/0';\n  return parseInt(cr.split('/')[1]) || 0;\n}\nconst weddingsCount = extractCount(items[0]);\nconst purchasesArray = Array.isArray(items[1].json.body) ? items[1].json.body : [];\nconst purchasesCount = extractCount(items[1]);\nconst purchasesAmount = purchasesArray.reduce((sum, p) => sum + (p.amount || 0), 0) / 100;\nconst rsvpCount = extractCount(items[2]);\nconst stripeData = items[3].json?.body?.data || [];\nconst stripeRevenue = stripeData.filter(pi => pi.status === 'succeeded').reduce((sum, pi) => sum + pi.amount, 0) / 100;\nconst weekLabel = $('Compute Week Range').item.json.weekLabel;\nconst html = `<table style=\"font-family:sans-serif;border-collapse:collapse;width:100%;max-width:600px\"><thead><tr style=\"background:#f4f0eb\"><th style=\"padding:12px;text-align:left;border-bottom:2px solid #d4c9be\">Métrique</th><th style=\"padding:12px;text-align:right;border-bottom:2px solid #d4c9be\">Semaine</th></tr></thead><tbody><tr><td style=\"padding:10px 12px\">Nouveaux mariages</td><td style=\"padding:10px 12px;text-align:right\"><strong>${weddingsCount}</strong></td></tr><tr style=\"background:#fafafa\"><td style=\"padding:10px 12px\">Achats (Supabase)</td><td style=\"padding:10px 12px;text-align:right\"><strong>${purchasesCount}</strong> — ${purchasesAmount.toFixed(2)} €</td></tr><tr><td style=\"padding:10px 12px\">Revenus Stripe confirmés</td><td style=\"padding:10px 12px;text-align:right\"><strong>${stripeRevenue.toFixed(2)} €</strong></td></tr><tr style=\"background:#fafafa\"><td style=\"padding:10px 12px\">RSVPs soumis</td><td style=\"padding:10px 12px;text-align:right\"><strong>${rsvpCount}</strong></td></tr></tbody></table>`;\nreturn [{ json: { html, weekLabel } }];"
      }
    },
    {
      "id": "wf6-send-report",
      "name": "Send Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1440, 500],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"contact@thestudiopapeteriedigitale.fr\",\n  \"to\": [\"contact@thestudiopapeteriedigitale.fr\"],\n  \"subject\": \"📊 Rapport hebdo — Semaine du {{ $json.weekLabel }}\",\n  \"html\": {{ JSON.stringify($json.html) }}\n}",
        "options": {
          "response": {
            "response": {
              "includeResponseHeaders": true,
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      },
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "resend-api"
        }
      }
    }
