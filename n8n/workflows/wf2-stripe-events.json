{
  "name": "WF2 — Stripe Payment Events",
  "nodes": [
    {
      "id": "node-webhook",
      "name": "Stripe Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "stripe-events",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "node-verify-sig",
      "name": "Verify Stripe Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// En n8n 2.x, avec \"Raw Body\" ON, le corps brut est dans binary.data (base64)\nconst binaryData = $input.first().binary?.data;\nconst rawBody = binaryData\n  ? Buffer.from(binaryData.data, 'base64').toString('utf-8')\n  : JSON.stringify($input.first().body);\n\nconst sigHeader = $input.first().headers['stripe-signature'];\nconst secret = process.env.STRIPE_WEBHOOK_SECRET_N8N || '';\n\nconst parts = Object.fromEntries(\n  sigHeader.split(',').map(p => p.split('='))\n);\nconst timestamp = parts.t;\nconst expectedSig = parts.v1;\n\nif (!timestamp || !expectedSig) {\n  throw new Error('Missing stripe-signature fields');\n}\n\nconst payload = `${timestamp}.${rawBody}`;\nconst computedSig = crypto\n  .createHmac('sha256', secret)\n  .update(payload, 'utf8')\n  .digest('hex');\n\nconst computedBuf = Buffer.from(computedSig, 'hex');\nconst expectedBuf = Buffer.from(expectedSig, 'hex');\n\nif (computedBuf.length !== expectedBuf.length || !crypto.timingSafeEqual(computedBuf, expectedBuf)) {\n  throw new Error('Stripe signature mismatch');\n}\n\nconst event = JSON.parse(rawBody);\nreturn [{ json: event }];"
      }
    },
    {
      "id": "node-switch",
      "name": "Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [720, 300],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "payment_intent.succeeded",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputIndex": 0
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "payment_intent.payment_failed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputIndex": 1
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-expand-charges",
      "name": "Expand Charges",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 160],
      "parameters": {
        "method": "GET",
        "url": "=https://api.stripe.com/v1/payment_intents/{{ $json.data.object.id }}?expand[]=charges",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "stripeApi",
        "options": {
          "response": {
            "response": {
              "includeResponseHeaders": true
            }
          }
        }
      },
      "credentials": {
        "stripeApi": {
          "id": "stripe-api",
          "name": "stripe-api"
        }
      }
    },
    {
      "id": "node-extract-email",
      "name": "Extract Client Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 160],
      "parameters": {
        "jsCode": "const pi = $input.first().json;\nconst email =\n  pi.charges?.data?.[0]?.billing_details?.email ||\n  pi.receipt_email ||\n  'client inconnu';\nconst amount = (pi.amount / 100).toFixed(2);\nconst currency = (pi.currency || 'eur').toUpperCase();\nreturn [{ json: { email, amount, currency, paymentIntentId: pi.id } }];"
      }
    },
    {
      "id": "node-email-client",
      "name": "Email Client Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 160],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "resendApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"contact@thestudiopapeteriedigitale.fr\",\n  \"to\": [\"{{ $json.email }}\"],\n  \"subject\": \"✅ Votre commande est confirmée — The Studio\",\n  \"html\": \"<p style='font-family:sans-serif'>Bonjour,</p><p style='font-family:sans-serif'>Votre paiement de <strong>{{ $json.amount }} {{ $json.currency }}</strong> a bien été reçu.</p><p style='font-family:sans-serif'>— L'équipe The Studio</p>\"\n}",
        "options": {}
      },
      "credentials": {
        "resendApi": {
          "id": "resend-api",
          "name": "resend-api"
        }
      }
    },
    {
      "id": "node-log-supabase",
      "name": "Log to Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 160],
      "parameters": {
        "method": "POST",
        "url": "https://pftvcpxwbprmphhgwvxc.supabase.co/rest/v1/stripe_events",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            },
            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_SERVICE_ROLE_KEY_PLACEHOLDER"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"stripe_event_id\": \"{{ $('Verify Stripe Signature').item.json.id }}\",\n  \"event_type\": \"payment_intent.succeeded\",\n  \"payment_intent_id\": \"{{ $json.paymentIntentId }}\",\n  \"customer_email\": \"{{ $json.email }}\",\n  \"amount_cents\": {{ $('Expand Charges').item.json.amount }},\n  \"currency\": \"{{ $json.currency }}\",\n  \"status\": \"succeeded\"\n}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "supabase-rest",
          "name": "supabase-rest"
        }
      }
    },
    {
      "id": "node-extract-failure",
      "name": "Extract Failure Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 440],
      "parameters": {
        "jsCode": "const obj = $input.first().json.data.object;\nconst email =\n  obj.last_payment_error?.payment_method?.billing_details?.email ||\n  obj.receipt_email ||\n  'email inconnu';\nconst amount = (obj.amount / 100).toFixed(2);\nconst currency = (obj.currency || 'eur').toUpperCase();\nconst reason = obj.last_payment_error?.message || 'raison inconnue';\nreturn [{ json: { email, amount, currency, reason } }];"
      }
    },
    {
      "id": "node-alert-admin",
      "name": "Alert Admin Echec",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 440],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "resendApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"contact@thestudiopapeteriedigitale.fr\",\n  \"to\": [\"contact@thestudiopapeteriedigitale.fr\"],\n  \"subject\": \"⚠️ Paiement échoué — The Studio\",\n  \"html\": \"<p style='font-family:sans-serif'><strong>Paiement échoué</strong></p><ul style='font-family:sans-serif'><li>Client : {{ $json.email }}</li><li>Montant : {{ $json.amount }} {{ $json.currency }}</li><li>Raison : {{ $json.reason }}</li></ul>\"\n}",
        "options": {}
      },
      "credentials": {
        "resendApi": {
          "id": "resend-api",
          "name": "resend-api"
        }
      }
    }
  ],
  "connections": {
    "Stripe Webhook": {
      "main": [
        [
          {
            "node": "Verify Stripe Signature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Stripe Signature": {
      "main": [
        [
          {
            "node": "Event Type",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Event Type": {
      "main": [
        [
          {
            "node": "Expand Charges",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Extract Failure Info",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Expand Charges": {
      "main": [
        [
          {
            "node": "Extract Client Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Client Email": {
      "main": [
        [
          {
            "node": "Email Client Confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Client Confirmation": {
      "main": [
        [
          {
            "node": "Log to Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Failure Info": {
      "main": [
        [
          {
            "node": "Alert Admin Echec",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "pinData": {}
}
