    {
      "id": "code-format-html",
      "name": "Format Digest HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1600, 460],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst today = new Date().toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });\nconst rows = items.map(item => {\n  const d = item.json;\n  const img = d.ogImage ? `<img src=\"${d.ogImage}\" style=\"max-width:80px;max-height:50px;object-fit:cover\" />` : '';\n  const link = d.siteUrl ? `<a href=\"${d.siteUrl}\" style=\"color:#7c5c3e\">${d.siteUrl.replace('https://www.','').replace('https://','')}</a>` : '-';\n  return `<tr><td style=\"padding:8px 12px\">${link}</td><td style=\"padding:8px 12px;font-size:13px\">${d.description || '-'}</td><td style=\"padding:8px 12px;text-align:center\">${img}</td></tr>`;\n}).join('');\nconst html = `<p style=\"font-family:sans-serif\">Inspiration UI de la semaine :</p><table style=\"font-family:sans-serif;border-collapse:collapse;width:100%;max-width:700px\"><thead><tr style=\"background:#f4f0eb\"><th style=\"padding:8px 12px;text-align:left\">Site</th><th style=\"padding:8px 12px;text-align:left\">Description</th><th style=\"padding:8px 12px;text-align:center\">Aperçu</th></tr></thead><tbody>${rows}</tbody></table>`;\nreturn [{ json: { html, today } }];"
      }
    },

    {
      "id": "http-send-digest",
      "name": "Send Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1820, 460],
      "parameters": {
        "url": "https://api.resend.com/emails",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "contact@thestudiopapeteriedigitale.fr"
            },
            {
              "name": "to",
              "value": "=[\"contact@thestudiopapeteriedigitale.fr\"]"
            },
            {
              "name": "subject",
              "value": "=🎨 Inspiration UI — Semaine du {{ $json.today }}"
            },
            {
              "name": "html",
              "value": "={{ $json.html }}"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "resend-api"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
