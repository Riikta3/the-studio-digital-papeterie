          { "node": "GET withjoy.com", "type": "main", "index": 0 },
          { "node": "GET artifactuprising.com", "type": "main", "index": 0 },
          { "node": "GET paperless-post.com", "type": "main", "index": 0 }
        ]
      ]
    },

    "GET minted.com": {
