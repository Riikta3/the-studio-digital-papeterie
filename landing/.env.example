# ──────────────────────────────────────────────────────────────────────────
#  LANDING — modèle de configuration
#
#  Copier en `.env.local` et remplir. Les mêmes variables doivent exister sur
#  Vercel (Settings → Environment Variables), par environnement.
#
#  Toute variable SANS préfixe NEXT_PUBLIC_ est serveur uniquement et n'arrive
#  jamais dans le bundle navigateur.
# ──────────────────────────────────────────────────────────────────────────


# ─── 1. URLs des applications ─────────────────────────────────────────────
# OBLIGATOIRES EN PRODUCTION : une valeur manquante lève une erreur au lieu
# de retomber sur localhost, ce qui envoyait les clients payants vers une
# machine de dev après paiement, sans trace dans les logs. Voir src/lib/urls.ts
#
#   local : http://localhost:3002 et :3003
#   prod  : les vrais domaines
#
# Origine publique du landing. Pilote aussi canonical/hreflang/sitemap et
# robots.txt : une mauvaise valeur fait indexer le mauvais domaine par Google.
NEXT_PUBLIC_SITE_URL=https://www.thestudiopapeteriedigitale.com
# Espace des mariés — cible du lien magique envoyé après l'achat.
NEXT_PUBLIC_DASHBOARD_URL=https://app-the-studio-digital-papeterie.vercel.app

# Base des images des emails (logos PNG), lue par shared/emails/tokens.ts.
# Doit pointer sur une origine PUBLIQUEMENT accessible : les clients mail
# chargent ces images depuis leurs propres serveurs. Si le domaine est en
# MAINTENANCE_MODE, les logos ne s'affichent pas dans les emails envoyés.
NEXT_PUBLIC_LANDING_URL=https://www.thestudiopapeteriedigitale.com


# ─── 2. Supabase ──────────────────────────────────────────────────────────
# ANON_KEY : navigateur, soumise aux politiques RLS.
# SERVICE_ROLE_KEY : serveur uniquement, CONTOURNE RLS. Ne jamais exposer.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ─── 3. Stripe ────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Secret de signature de /api/webhooks/stripe. SANS LUI LE WEBHOOK RENVOIE 400
# ET AUCUNE LIGNE DE FACTURATION N'EST CRÉÉE — le mariage est quand même
# provisionné par la server action, donc l'échec est totalement silencieux.
#
#   local : stripe listen --forward-to localhost:3002/api/webhooks/stripe
#           (affiche whsec_… — c'est cette valeur)
#   prod  : Dashboard → Developers → Webhooks → l'endpoint → Signing secret
#
# ⚠️  UN endpoint portant TOUS les événements, pas un endpoint par événement :
#     chacun a son propre secret et le code n'en connaît qu'un.
#     Événements requis : payment_intent.succeeded, charge.dispute.created
STRIPE_WEBHOOK_SECRET=whsec_xxx


# ─── 4. Emails transactionnels (Resend) ───────────────────────────────────
# Le domaine thestudiopapeteriedigitale.com est déjà vérifié sur Resend.
#
# ⚠️  SANS CETTE CLÉ le couple paie, son compte est créé, et il ne reçoit NI
#     email de bienvenue NI lien de connexion. Le parcours étant sans mot de
#     passe, il n'a alors aucun moyen d'entrer dans son espace.
#     C'est la panne constatée le 13/09/2026 en préproduction.
RESEND_API_KEY=

# Destinataire des messages du formulaire de contact.
# Vide → l'adresse expéditrice reçoit la copie.
CONTACT_NOTIFY_TO=


# ─── 5. Identité légale du vendeur (facturation) ──────────────────────────
# Obligatoires pour émettre une facture (art. L441-9 code de commerce) : sans
# elles le webhook refuse de générer le PDF et le client paie sans facture. Le
# paiement et la création du site fonctionnent quand même — l'échec est
# silencieux côté client, visible seulement dans les logs ([INVOICE_CONFIG]).
#
# Serveur uniquement : les factures sont rendues dans le webhook.
#
# Raison sociale telle qu'immatriculée.
COMPANY_LEGAL_NAME=
# Forme juridique : SASU, EURL, Entrepreneur individuel…
COMPANY_LEGAL_FORM=
# 14 chiffres, sans espaces.
COMPANY_SIRET=
COMPANY_ADDRESS=
COMPANY_POSTAL_CODE=
COMPANY_CITY=

# Facultatifs — omis de la facture si vides.
# Capital social en euros (vide pour un entrepreneur individuel).
COMPANY_SHARE_CAPITAL=
# Ville du greffe RCS (vide pour une micro-entreprise sans RCS).
COMPANY_RCS_CITY=
COMPANY_PHONE=
# Défauts : "The Studio Digital Papeterie" / contact@… / www.… / France
COMPANY_TRADING_NAME=
COMPANY_EMAIL=
COMPANY_WEBSITE=
COMPANY_COUNTRY=

# Régime de TVA. Défaut "franchise" (franchise en base) : aucune TVA facturée,
# mention obligatoire de l'article 293 B sur la facture. Passer à "standard"
# une fois le seuil franchi — les prix deviennent TTC et la facture détaille
# HT / TVA 20 % / TTC.
COMPANY_VAT_REGIME=franchise
# TVA intracommunautaire. Obligatoire UNIQUEMENT si VAT_REGIME=standard
# (l'émission est alors bloquée sans lui).
COMPANY_VAT_NUMBER=


# ─── 6. Intégrations tierces ──────────────────────────────────────────────
# Spotify : recherche de morceaux du module playlist.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Affiche la ligne WhatsApp dans la bulle de contact. Chiffres uniquement avec
# l'indicatif pays, sans "+" (ex. 33612345678). Vide → la bulle ne propose que
# le formulaire et l'email.
NEXT_PUBLIC_WHATSAPP_NUMBER=


# ─── 7. Exploitation ──────────────────────────────────────────────────────
# true → tout le site redirige vers /coming-soon.
# Lue au BUILD (src/proxy.ts) : la modifier impose un redéploiement, changer
# la variable sur Vercel ne suffit pas.
MAINTENANCE_MODE=false


# ─── 8. Tracking Meta — PAS ENCORE CÂBLÉ ──────────────────────────────────
# Aucune de ces deux variables n'est lue par le code aujourd'hui : le bandeau
# de consentement est en place et les attend. Voir docs/tracking.md.
#
# Pixel ID — public, il finit dans le JS de la page de toute façon.
# Meta Events Manager > Sources de données > le pixel (15-16 chiffres).
NEXT_PUBLIC_META_PIXEL_ID=
# Token de l'API Conversions — SECRET, serveur uniquement.
# Events Manager > le pixel > Paramètres > API de conversions.
META_CONVERSIONS_API_TOKEN=
