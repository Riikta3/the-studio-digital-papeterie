# ─── Stripe ───────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Signing secret for /api/webhooks/stripe. WITHOUT IT THE WEBHOOK RETURNS 500
# AND NO BILLING ROW IS EVER CREATED — the wedding is still provisioned by the
# server action, so the failure is silent.
#   local: stripe listen --forward-to localhost:3010/api/webhooks/stripe
#          (prints whsec_… — that value goes here)
#   prod:  Dashboard → Developers → Webhooks → the endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Spotify (playlist module) ────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Cross-app origins ────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — a missing value throws instead of falling back to
# localhost, which used to send paying customers to a dev machine after
# checkout with no trace in the logs. See src/lib/urls.ts.
#
#   local: leave unset (defaults to localhost:3010 / :3003)
#   prod:  set both in Vercel → Settings → Environment Variables
#
# Public landing origin. Also drives canonical/hreflang/sitemap + robots.txt,
# so a wrong value here makes Google index the wrong domain.
NEXT_PUBLIC_SITE_URL=https://www.thestudiopapeteriedigitale.com
# Couples' dashboard — target of the post-purchase magic link.
NEXT_PUBLIC_DASHBOARD_URL=https://app-the-studio-digital-papeterie.vercel.app
NEXT_PUBLIC_DEMO_WEDDING_CODE=
MAINTENANCE_MODE=false
SUPABASE_SMTP_DEV=

# ─── Tracking Meta (pixel + API Conversions) ─────────────────────────────────
# Rien n'est câblé aujourd'hui : le bandeau de consentement est en place et
# attend ces deux valeurs. Voir docs/tracking.md pour où les récupérer et ce
# qu'il reste à brancher.
#
# Pixel ID — public, il finit dans le JS de la page de toute façon.
# Meta Events Manager > Sources de données > le pixel (15-16 chiffres).
NEXT_PUBLIC_META_PIXEL_ID=
# Token de l'API Conversions — SECRET, serveur uniquement. Pas de préfixe
# NEXT_PUBLIC_, jamais committé. Events Manager > le pixel > Paramètres >
# API de conversions > Générer un token d'accès.
META_CONVERSIONS_API_TOKEN=

# ─── Contact form notifications ──────────────────────────────────────────────
# Contact form notifications. The domain thestudiopapeteriedigitale.com is
# already Verified on Resend; this is only the API key.
RESEND_API_KEY=
# Where contact messages are announced. Defaults to the sender address when
# left empty.
CONTACT_NOTIFY_TO=
# Optional: enables the WhatsApp row in the floating contact bubble. Digits
# only, with the country code and no "+" (e.g. 33612345678). Left empty, the
# bubble simply shows the form and email options.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Identité légale du vendeur (facturation) ────────────────────────────────
# Obligatoires pour émettre une facture : sans elles, le webhook Stripe refuse
# de générer le PDF et le client paie sans recevoir de facture. Le paiement et
# la création du site fonctionnent quand même — l'échec est silencieux côté
# client, visible seulement dans les logs ([INVOICE_CONFIG]).
#
# Serveur uniquement (pas de préfixe NEXT_PUBLIC_) : les factures sont rendues
# dans le webhook, rien de tout ça n'arrive dans le bundle navigateur.
#
# En prod : Vercel → Settings → Environment Variables.
#
# Raison sociale telle qu'immatriculée.
COMPANY_LEGAL_NAME=
# Forme juridique : SASU, EURL, Entrepreneur individuel…
COMPANY_LEGAL_FORM=
# 14 chiffres, sans espaces.
COMPANY_SIRET=
COMPANY_ADDRESS=
COMPANY_POSTAL_CODE=
COMPANY_CITY=
#
# Facultatifs — omis de la facture si vides.
# Capital social en euros (laisser vide pour un entrepreneur individuel).
COMPANY_SHARE_CAPITAL=
# Ville du greffe RCS (vide pour une micro-entreprise sans RCS).
COMPANY_RCS_CITY=
COMPANY_PHONE=
# Par défaut : "The Studio Digital Papeterie" / contact@… / www.…
COMPANY_TRADING_NAME=
COMPANY_EMAIL=
COMPANY_WEBSITE=
COMPANY_COUNTRY=
#
# Régime de TVA. Par défaut "franchise" (franchise en base) : aucune TVA
# facturée, mention obligatoire de l'article 293 B sur la facture.
# Passer à "standard" une fois le seuil franchi — les prix affichés deviennent
# alors TTC et la facture détaille HT / TVA 20 % / TTC.
COMPANY_VAT_REGIME=franchise
# Numéro de TVA intracommunautaire. Obligatoire UNIQUEMENT si
# COMPANY_VAT_REGIME=standard (l'émission est alors bloquée sans lui).
COMPANY_VAT_NUMBER=
