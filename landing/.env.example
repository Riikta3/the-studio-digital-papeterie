# ─── Stripe ───────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Signing secret for /api/webhooks/stripe. WITHOUT IT THE WEBHOOK RETURNS 500
# AND NO BILLING ROW IS EVER CREATED — the wedding is still provisioned by the
# server action, so the failure is silent.
#   local: stripe listen --forward-to localhost:3002/api/webhooks/stripe
#          (prints whsec_… — that value goes here)
#   prod:  Dashboard → Developers → Webhooks → the endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Spotify (playlist module) ────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3003
NEXT_PUBLIC_DEMO_WEDDING_CODE=
MAINTENANCE_MODE=false
SUPABASE_SMTP_DEV=
